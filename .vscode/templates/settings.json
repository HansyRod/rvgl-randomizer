{
    // Copy this file to .vscode/settings.json and leave it as-is.
    // CMake Tools will handle the rest on first configure.
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.generator": "Visual Studio 17 2022",
    "cmake.platform": "x64",
    "cmake.autoConfigureOnOpen": true,
    "cmake.defaultVariant": "Debug",
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "files.associations": {
        "*.h": "cpp"
    }
}
