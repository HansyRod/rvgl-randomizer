{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rvgl-randomizer",
  "version": "0.1.0",
  "identifier": "com.rod.rvgl-randomizer",
  "build": {
    "beforeDevCommand": "npm run build:dll && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:all",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RVGL Randomizer",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/randomizer.dll"]
  }
}
