{
  "name": "rvgl-randomizer-ui",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "release": "tauri build",
    "cmake:configure": "cmake -S .. -B ../build -A x64",
    "cmake:build": "cmake --build ../build --config Release --target randomizer",
    "cmake:build:dbg": "cmake --build ../build --config Debug   --target randomizer",
    "copy:dll": "cmake -E copy ../build/DLL/Release/randomizer.dll src-tauri/resources/randomizer.dll",
    "copy:dll:dbg": "cmake -E copy ../build/DLL/Debug/randomizer.dll   src-tauri/resources/randomizer.dll",
    "build:dll": "npm run cmake:configure && npm run cmake:build:dbg && npm run copy:dll:dbg",
    "build:dll:release": "npm run cmake:configure && npm run cmake:build     && npm run copy:dll",
    "build:all": "npm run build:dll:release && npm run build",
    "md-to-doc": "cd .. && pandoc README.MD -f markdown -t docx -s -o README.docx && pandoc CONFIGURE.MD -f markdown -t docx -s -o CONFIGURE.docx"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.5.0",
    "vite": "^7.0.4"
  }
}
